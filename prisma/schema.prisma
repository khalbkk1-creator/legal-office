// نظام إدارة مكتب المحاماة - قاعدة البيانات
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  // PostgreSQL - مناسب للنشر على Vercel + Supabase
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["public"]
}

enum Role {
  PARTNER   // شريك
  LAWYER    // محامي
  SECRETARY // سكرتير

  @@schema("public")
}

enum CaseStatus {
  UNDER_REVIEW   // تحت الدراسة
  UNDER_APPROVAL // تحت الاعتماد
  ACTIVE         // جارية
  ON_HOLD        // معلقة
  CLOSED         // مغلقة

  @@schema("public")
}

enum ClientType {
  INDIVIDUAL // فرد
  COMPANY    // شركة
  GOVERNMENT // جهة حكومية

  @@schema("public")
}

enum PaymentStatus {
  PAID    // مدفوعة
  UNPAID  // غير مدفوعة
  PARTIAL // مدفوعة جزئياً

  @@schema("public")
}

enum QuotationStatus {
  PENDING  // بانتظار الرد
  ACCEPTED // مقبول
  REJECTED // مرفوض
  EXPIRED  // منتهي الصلاحية

  @@schema("public")
}

model Quotation {
  id              String          @id @default(cuid())
  quoteNumber     String          @unique // رقم عرض السعر
  description     String
  amount          Float
  applyVat        Boolean         @default(true)
  vatAmount       Float           @default(0)
  totalAmount     Float
  status          QuotationStatus @default(PENDING)
  validUntil      DateTime?
  convertedSaleId String? // إذا تحوّل لفاتورة فعلية

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  caseId String?
  case   Case?   @relation(fields: [caseId], references: [id])

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  serviceRequest ServiceRequest?

  @@index([clientId])
  @@index([caseId])
  @@index([status])
  @@schema("public")
}

enum ConsultationStatus {
  PENDING   // بانتظار المراجعة
  CONFIRMED // تم التأكيد
  DONE      // تمت الاستشارة
  CANCELLED // ملغاة

  @@schema("public")
}

model ConsultationRequest {
  id             String             @id @default(cuid())
  name           String
  phone          String
  email          String?
  notes          String?
  attachmentUrl  String?
  attachmentName String?
  requestedDate  DateTime // تاريخ ووقت الموعد المطلوب
  status         ConsultationStatus @default(PENDING)
  consultationType String? // PHONE / IN_PERSON / WRITTEN
  serviceRequestId String? // مرجع طلب الخدمة الأصلي إن وجد
  clientId       String?
  client         Client?  @relation(fields: [clientId], references: [id])
  saleId         String?  @unique
  sale           Sale?    @relation(fields: [saleId], references: [id])
  responseFileUrl  String? // ملف الرد للاستشارة الكتابية
  responseFileName String?

  assignedToId String? // المحامي/الموظف المسؤول عن هذه الاستشارة
  assignedTo   User?   @relation("AssignedConsultations", fields: [assignedToId], references: [id])

  managerApprovedById String?
  managerApprovedBy   User?     @relation("ApprovedConsultations", fields: [managerApprovedById], references: [id])
  managerApprovedAt   DateTime?

  createdAt      DateTime           @default(now())

  noteLog ConsultationNote[]

  @@index([clientId])
  @@index([status])
  @@index([requestedDate])
  @@schema("public")
}

model ConsultationNote {
  id                   String              @id @default(cuid())
  consultationRequestId String
  consultationRequest  ConsultationRequest @relation(fields: [consultationRequestId], references: [id], onDelete: Cascade)
  authorId             String?
  author               User?               @relation(fields: [authorId], references: [id])
  note                 String
  createdAt            DateTime            @default(now())

  @@index([consultationRequestId])
  @@schema("public")
}

model ExpenseCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  expenses  Expense[]
  paymentRequests PaymentRequest[]

  @@schema("public")
}

model Expense {
  id          String   @id @default(cuid())
  description String
  amount      Float
  vatAmount   Float    @default(0) // ضريبة القيمة المضافة المدفوعة ضمن المصروف (مدخلات)
  expenseDate DateTime @default(now())
  receiptUrl  String?
  receiptName String?

  categoryId String?
  category   ExpenseCategory? @relation(fields: [categoryId], references: [id])

  caseId String?
  case   Case?   @relation(fields: [caseId], references: [id])

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([caseId])
  @@index([categoryId])
  @@index([expenseDate])
  @@schema("public")
}

enum ServiceRequestType {
  CASE         // قضية
  CONSULTATION // استشارة

  @@schema("public")
}

enum ServiceRequestStatus {
  NEW             // طلب جديد
  DOCS_REQUESTED  // بانتظار مستندات من العميل
  DOCS_SUBMITTED  // العميل رفع المستندات
  QUOTE_SENT      // تم إرسال عرض سعر
  ACCEPTED        // العميل وافق على العرض
  CONVERTED       // تم التحويل لقضية/استشارة
  REJECTED        // مرفوض

  @@schema("public")
}

model ServiceRequest {
  id                      String               @id @default(cuid())
  clientId                String
  client                  Client               @relation(fields: [clientId], references: [id])
  requestType             ServiceRequestType
  notes                   String?
  status                  ServiceRequestStatus @default(NEW)
  requestedCategoryIds    String[]             @default([])
  clarificationRequest    String? // طلب المحامي من العميل (توضيح إضافي)
  clientReply             String? // رد العميل على طلب التوضيح
  consultationType        String? // PHONE / IN_PERSON / WRITTEN
  requestedDate           DateTime? // تاريخ ووقت الاستشارة المطلوب
  durationMinutes         Int? // مدة الاستشارة بالدقائق
  estimatedCost           Float? // التكلفة المحسوبة تلقائياً
  quotationId             String?              @unique
  quotation               Quotation?           @relation(fields: [quotationId], references: [id])
  convertedCaseId         String?
  convertedConsultationId String?
  createdAt               DateTime             @default(now())

  documents ServiceRequestDocument[]

  @@index([clientId])
  @@index([status])
  @@schema("public")
}

model ServiceRequestDocument {
  id               String         @id @default(cuid())
  serviceRequestId String
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  categoryId       String?
  category         DocumentCategory? @relation(fields: [categoryId], references: [id])
  fileName         String
  fileUrl          String
  fileSize         Int?
  createdAt        DateTime       @default(now())

  @@index([serviceRequestId])
  @@index([categoryId])
  @@schema("public")
}

model CaseMessage {
  id         String   @id @default(cuid())
  caseId     String
  case       Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  fromClient Boolean  @default(true) // true = من العميل، false = رد المحامي
  message    String
  createdAt  DateTime @default(now())

  @@index([caseId])
  @@schema("public")
}

model TimeEntry {
  id          String   @id @default(cuid())
  caseId      String
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  lawyerId    String
  lawyer      User     @relation(fields: [lawyerId], references: [id])
  description String
  minutes     Int      // مدة العمل بالدقائق
  hourlyRate  Float    // السعر بالساعة وقت التسجيل
  billed      Boolean  @default(false)
  saleId      String?
  sale        Sale?    @relation(fields: [saleId], references: [id])
  entryDate   DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([caseId])
  @@index([billed])
  @@schema("public")
}

enum AccountType {
  ASSET     // أصول
  LIABILITY // التزامات
  EQUITY    // حقوق ملكية
  REVENUE   // إيرادات
  EXPENSE   // مصروفات

  @@schema("public")
}

model Account {
  id       String      @id @default(cuid())
  code     String      @unique // رقم الحساب
  name     String
  type     AccountType
  parentId String?
  parent   Account?    @relation("AccountHierarchy", fields: [parentId], references: [id])
  children Account[]   @relation("AccountHierarchy")
  isSystem Boolean     @default(false) // حساب أساسي بالنظام، لا يُحذف
  isActive Boolean     @default(true)
  analysisType String  @default("NONE") // NONE / SUPPLIER / CLIENT / COST_CENTER — يفرض اختيار بُعد تحليلي على القيود
  createdAt DateTime   @default(now())

  journalLines JournalEntryLine[]
  recurringLines RecurringEntryLine[]
  bankStatementLines BankStatementLine[]
  reconciliationRecords ReconciliationRecord[]
  payee Payee?

  @@index([type])
  @@index([parentId])
  @@schema("public")
}

model JournalEntry {
  id          String   @id @default(cuid())
  entryNumber String   @unique // رقم القيد
  date        DateTime @default(now())
  description String
  status      String   @default("POSTED") // DRAFT / POSTED — المسودة لا تدخل بالأرصدة
  sourceType  String? // SALE / EXPENSE / PAYMENT / MANUAL
  sourceId    String? // معرّف السجل المصدر إن وجد

  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])

  reversalOfId String?       @unique
  reversalOf   JournalEntry? @relation("EntryReversal", fields: [reversalOfId], references: [id])
  reversedBy   JournalEntry? @relation("EntryReversal")

  attachmentUrl  String?
  attachmentName String?

  createdAt DateTime @default(now())
  lines     JournalEntryLine[]

  @@index([date])
  @@index([sourceType, sourceId])
  @@schema("public")
}

model JournalEntryLine {
  id             String       @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id])
  debit          Float        @default(0)
  credit         Float        @default(0)
  description    String?

  // الأبعاد التحليلية (لا تُنشئ حسابات فرعية بالدليل)
  payeeId      String?
  payee        Payee?      @relation(fields: [payeeId], references: [id])
  clientId     String?
  client       Client?     @relation(fields: [clientId], references: [id])
  costCenterId String?
  costCenter   CostCenter? @relation(fields: [costCenterId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
  @@index([payeeId])
  @@index([clientId])
  @@index([costCenterId])
  @@schema("public")
}

model CostCenter {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  journalLines    JournalEntryLine[]
  paymentRequests PaymentRequest[]

  @@schema("public")
}

model ReconciliationRecord {
  id             String   @id @default(cuid())
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id])
  reconciledDate DateTime
  bookBalance    Float // الرصيد حسب دفتر الأستاذ وقت المطابقة
  bankBalance    Float // الرصيد حسب كشف الحساب البنكي (يُدخل يدوياً)
  difference     Float
  notes          String?

  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([accountId])
  @@schema("public")
}

model BankStatementLine {
  id              String   @id @default(cuid())
  accountId       String
  account         Account  @relation(fields: [accountId], references: [id])
  date            DateTime
  description     String
  amount          Float // موجب = إيداع، سالب = سحب
  matched         Boolean  @default(false)
  matchedLineId   String? // معرّف سطر القيد المطابق (JournalEntryLine.id) بدون علاقة صارمة
  createdAt       DateTime @default(now())

  @@index([accountId])
  @@schema("public")
}

model RecurringEntry {
  id             String   @id @default(cuid())
  description    String
  dayOfMonth     Int      @default(1) // يوم الترحيل المقترح كل شهر (1-28)
  isActive       Boolean  @default(true)
  lastPostedYear  Int?
  lastPostedMonth Int?

  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  lines RecurringEntryLine[]

  @@schema("public")
}

model RecurringEntryLine {
  id               String         @id @default(cuid())
  recurringEntryId String
  recurringEntry   RecurringEntry @relation(fields: [recurringEntryId], references: [id], onDelete: Cascade)
  accountId        String
  account          Account        @relation(fields: [accountId], references: [id])
  debit            Float          @default(0)
  credit           Float          @default(0)

  @@schema("public")
}

model Payee {
  id        String   @id @default(cuid())
  name      String
  type      String   @default("INDIVIDUAL") // INDIVIDUAL / COMPANY
  phone     String?
  notes     String?
  accountId String?  @unique // (قديم) حساب فرعي — الموردون الجدد يُعالَجون كبُعد تحليلي على ذمم الموردين 2100
  account   Account? @relation(fields: [accountId], references: [id])
  clientId  String?  @unique // لو المستفيد هو عميل موجود بقاعدة العملاء (مبلغ نرجعه له)
  client    Client?  @relation(fields: [clientId], references: [id])
  createdAt DateTime @default(now())

  paymentRequests PaymentRequest[]
  journalLines    JournalEntryLine[]

  @@schema("public")
}

model PaymentRequest {
  id            String   @id @default(cuid())
  requestNumber String   @unique
  description   String
  amount        Float
  vatAmount     Float    @default(0)

  payeeId String
  payee   Payee  @relation(fields: [payeeId], references: [id])

  categoryId String?
  category   ExpenseCategory? @relation(fields: [categoryId], references: [id])

  caseId String?
  case   Case?   @relation(fields: [caseId], references: [id])

  costCenterId String?
  costCenter   CostCenter? @relation(fields: [costCenterId], references: [id])

  requestedById String
  requestedBy   User   @relation("RequestedPayments", fields: [requestedById], references: [id])

  status String @default("PENDING_MANAGER") // PENDING_MANAGER / PENDING_ACCOUNTANT / PENDING_FINANCE / APPROVED / REJECTED / PAID / CLOSED

  needsManagerApproval Boolean @default(true)
  managerApprovedById  String?
  managerApprovedBy    User?     @relation("ManagerApprovedPayments", fields: [managerApprovedById], references: [id])
  managerApprovedAt    DateTime?
  managerNote          String?

  accountantApprovedById String?
  accountantApprovedBy   User?     @relation("AccountantApprovedPayments", fields: [accountantApprovedById], references: [id])
  accountantApprovedAt   DateTime?
  accountantNote         String?

  financeApprovedById String?
  financeApprovedBy   User?     @relation("FinanceApprovedPayments", fields: [financeApprovedById], references: [id])
  financeApprovedAt   DateTime?
  financeNote         String?

  rejectedById    String?
  rejectedBy      User?     @relation("RejectedPayments", fields: [rejectedById], references: [id])
  rejectedAt      DateTime?
  rejectionReason String?

  returnedById String?
  returnedBy   User?     @relation("ReturnedPayments", fields: [returnedById], references: [id])
  returnedAt   DateTime?
  returnReason String?

  paymentAccountId  String?
  paidAt            DateTime?
  transferProofUrl  String?
  transferProofName String?

  invoiceUrl       String?
  invoiceName      String?
  invoiceUploadedAt DateTime?

  closedById String?
  closedBy   User?     @relation("ClosedPayments", fields: [closedById], references: [id])
  closedAt   DateTime?

  attachmentUrl  String
  attachmentName String

  liabilityJournalEntryId String? @unique
  paymentJournalEntryId   String? @unique
  closingJournalEntryId   String? @unique

  createdAt DateTime @default(now())

  @@index([status])
  activities PaymentRequestActivity[]

  @@index([requestedById])
  @@schema("public")
}

model PaymentRequestActivity {
  id        String   @id @default(cuid())
  requestId String
  request   PaymentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  userId    String
  userName  String
  action    String // CREATED / APPROVED / REJECTED / PAID / INVOICE_UPLOADED / CLOSED / COMMENT
  stage     String? // MANAGER / ACCOUNTANT / FINANCE
  note      String?
  createdAt DateTime @default(now())

  @@index([requestId])
  @@schema("public")
}

model AccountingPeriodLock {
  id           String   @id @default(cuid())
  lockedUntil  DateTime // كل قيد بتاريخ أقدم أو يساوي هذا التاريخ يصير مقفل
  lockedById   String?
  lockedByName String
  createdAt    DateTime @default(now())

  @@schema("public")
}

model Alert {
  id          String   @id @default(cuid())
  type        String // HEARING_REMINDER / APPEAL_DEADLINE / OVERDUE_INVOICE
  title       String
  description String
  entityType  String // Case / Sale / Hearing
  entityId    String
  dueDate     DateTime? // التاريخ المرتبط بالتنبيه (موعد الجلسة، آخر يوم استئناف...)
  emailSent   Boolean  @default(false) // جاهز لربط الإيميل لاحقاً بدون تعديل البنية
  createdAt   DateTime @default(now())

  @@unique([type, entityId, dueDate])
  @@index([type])
  @@schema("public")
}

model ApiKey {
  id         String    @id @default(cuid())
  name       String // اسم وصفي (مثال: Zapier - قضايا)
  keyHash    String    @unique // تُخزّن مشفّرة، المفتاح الحقيقي يُعرض مرة وحدة فقط عند الإنشاء
  keyPrefix  String // أول 8 أحرف تُعرض بالواجهة للتمييز فقط (المفتاح الكامل لا يُخزّن نصياً)
  lastUsedAt DateTime?
  isActive   Boolean   @default(true)
  createdById String?
  createdAt  DateTime  @default(now())

  @@schema("public")
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  userName    String // مخزّن مباشرة حتى لو انحذف المستخدم لاحقاً
  action      String // CREATE / UPDATE / DELETE / REVERSE / RESET
  entityType  String // Account / JournalEntry / Sale / Expense ...
  entityId    String?
  description String
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@schema("public")
}

model OfficeSettings {
  id            String   @id @default(cuid())
  officeName    String?
  logoUrl       String?
  letterheadUrl String? // صورة ورق الشركة (خلفية كاملة للصفحة)
  taxNumber     String? // الرقم الضريبي
  phone         String?
  address       String?
  defaultHourlyRate Float? // سعر الساعة الافتراضي
  phoneConsultationRate    Float? // سعر ساعة الاستشارة الهاتفية
  inPersonConsultationRate Float? // سعر ساعة الاستشارة الحضورية
  writtenConsultationRate  Float? // سعر ساعة الاستشارة الكتابية
  consultationDays      Int[]    @default([0,1,2,3,4]) // أيام توفر الاستشارات (0=أحد...6=سبت)
  consultationStartTime String? // وقت بداية الحجز، مثال "09:00"
  consultationEndTime   String? // وقت نهاية الحجز، مثال "17:00"
  updatedAt     DateTime @updatedAt

  @@schema("public")
}

model Sale {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique // رقم الفاتورة
  description   String        // وصف الخدمة
  amount        Float         // المبلغ قبل الضريبة
  applyVat      Boolean       @default(true)
  vatAmount     Float         @default(0)
  totalAmount   Float         // المبلغ الإجمالي (شامل الضريبة)
  paidAmount    Float         @default(0)
  paymentStatus PaymentStatus @default(UNPAID)
  saleDate      DateTime      @default(now())

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  caseId String?
  case   Case?   @relation(fields: [caseId], references: [id])

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  timeEntries TimeEntry[]
  consultationRequest ConsultationRequest?

  @@index([clientId])
  @@index([caseId])
  @@index([paymentStatus])
  @@index([saleDate])
  @@schema("public")
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique // اسم الإدارة (مثال: الإدارة المالية، الإدارة القانونية)
  createdAt DateTime @default(now())

  positions Position[]

  @@schema("public")
}

model Position {
  id                 String   @id @default(cuid())
  name               String   @unique // المسمى الوظيفي (مثال: محاسب، مدير مالي)
  allowedModules     String[] @default([]) // الشاشات المسموح الوصول لها
  isAccountant       Boolean  @default(false) // يعتمد كمرحلة "المحاسب" بطلبات الصرف
  isFinancialManager Boolean  @default(false) // يعتمد كمرحلة "المدير المالي" بطلبات الصرف
  departmentId       String?
  department         Department? @relation(fields: [departmentId], references: [id])

  // صلاحيات دقيقة داخل النظام المحاسبي — كل إجراء له صلاحية مستقلة
  acctJournalCreate     Boolean @default(false) // إنشاء قيد يدوي جديد (مسودة أو مباشر)
  acctJournalConfirm    Boolean @default(false) // اعتماد قيد مسودة
  acctJournalEdit       Boolean @default(false) // تعديل قيد مسودة
  acctJournalDelete     Boolean @default(false) // حذف قيد نهائياً
  acctJournalReverse    Boolean @default(false) // عكس قيد
  acctJournalAttach     Boolean @default(false) // رفع مرفق لقيد
  acctChartCreate       Boolean @default(false) // إضافة حساب جديد بالدليل
  acctChartEdit         Boolean @default(false) // تعديل/تفعيل/تعطيل حساب
  acctChartDelete       Boolean @default(false) // حذف حساب من الدليل
  acctChartReset        Boolean @default(false) // إعادة تعيين الدليل بالكامل
  acctPeriodLock        Boolean @default(false) // قفل/فك قفل الفترات المحاسبية
  acctOpeningBalances   Boolean @default(false) // تسجيل/تعديل الأرصدة الافتتاحية
  acctRecurringManage   Boolean @default(false) // إنشاء/تعديل/حذف قيد متكرر
  acctRecurringPost     Boolean @default(false) // ترحيل قيد متكرر يدوياً
  acctReconciliationManage Boolean @default(false) // إضافة/حذف حركات كشف، مطابقة يدوية وتلقائية
  acctReconciliationSave   Boolean @default(false) // حفظ ملخص المطابقة كسجل رسمي
  acctViewOnly          Boolean @default(false) // عرض فقط، يعطّل كل الصلاحيات أعلاه بغض النظر عن قيمتها

  createdAt          DateTime @default(now())

  users User[]

  @@schema("public")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(LAWYER)
  phone        String?
  createdAt    DateTime @default(now())

  managerId String?
  manager   User?   @relation("ManagerOf", fields: [managerId], references: [id])
  directReports User[] @relation("ManagerOf")

  positionId String?
  position   Position? @relation(fields: [positionId], references: [id])

  assignedCases Case[]        @relation("AssignedLawyer")
  caseUpdates   CaseUpdate[]
  uploadedDocuments CaseDocument[]
  sales         Sale[]
  quotations    Quotation[]
  expenses      Expense[]
  timeEntries   TimeEntry[]
  consultationNotes ConsultationNote[]
  journalEntries JournalEntry[]
  recurringEntries RecurringEntry[]
  reconciliationRecords ReconciliationRecord[]

  requestedPayments      PaymentRequest[] @relation("RequestedPayments")
  managerApprovedPayments PaymentRequest[] @relation("ManagerApprovedPayments")
  accountantApprovedPayments PaymentRequest[] @relation("AccountantApprovedPayments")
  financeApprovedPayments PaymentRequest[] @relation("FinanceApprovedPayments")
  rejectedPayments        PaymentRequest[] @relation("RejectedPayments")
  returnedPayments        PaymentRequest[] @relation("ReturnedPayments")
  closedPayments          PaymentRequest[] @relation("ClosedPayments")
  assignedConsultations   ConsultationRequest[] @relation("AssignedConsultations")
  approvedConsultations   ConsultationRequest[] @relation("ApprovedConsultations")

  @@schema("public")
}

model Client {
  id        String     @id @default(cuid())
  name      String
  type      ClientType @default(INDIVIDUAL)
  idNumber  String?    // رقم الهوية / السجل التجاري
  phone     String?
  email     String?
  address   String?
  notes     String?
  accessToken String? @unique // رمز رابط بوابة العميل (الطريقة القديمة)
  passwordHash String? // كلمة مرور حساب بوابة العميل (تسجيل الدخول بالإيميل)

  // حماية البوابة
  accessTokenExpiresAt DateTime? // انتهاء صلاحية الرابط
  portalDisabled       Boolean   @default(false) // تعطيل وصول العميل للبوابة بالكامل
  failedLoginCount     Int       @default(0)
  lockedUntil          DateTime? // قفل مؤقت بعد محاولات فاشلة
  lastPortalLoginAt    DateTime?
  emailVerifiedAt      DateTime?
  portalAccessLogs     PortalAccessLog[]
  portalOtps           PortalOtp[]
  createdAt DateTime   @default(now())

  cases Case[]
  sales Sale[]
  quotations Quotation[]
  serviceRequests ServiceRequest[]
  consultationRequests ConsultationRequest[]
  payeeLink Payee?
  journalLines JournalEntryLine[]

  @@index([phone])
  @@index([email])
  @@schema("public")
}

model PortalAccessLog {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  event     String // LINK_ACCESS / LOGIN_SUCCESS / LOGIN_FAILED / LOCKED / REGISTER / PROFILE_UPDATE / LINK_REVOKED / PORTAL_DISABLED
  ip        String?
  userAgent String?
  path      String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([clientId, createdAt])
  @@schema("public")
}

// رموز التحقق لبوابة العميل (دخول / تفعيل / استعادة)
model PortalOtp {
  id         String    @id @default(cuid())
  clientId   String?
  client     Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  email      String // البريد المستهدف (يسمح بالتسجيل الذاتي قبل وجود سجل العميل)
  purpose    String // LOGIN / ACTIVATE / RESET
  channel    String // EMAIL / SMS
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, purpose, createdAt])
  @@schema("public")
}

enum AppealCategory {
  REGULAR   // عادية - 30 يوم
  EXECUTION // تنفيذ - 10 أيام
  URGENT    // مستعجلة - 10 أيام

  @@schema("public")
}

model Case {
  id             String     @id @default(cuid())
  caseNumber     String     @unique // رقم القضية
  title          String     // موضوع القضية
  caseType       String     // نوع القضية (تجارية/عمالية/عقارية...)
  status         CaseStatus @default(UNDER_REVIEW)
  previousStatus String? // الحالة السابقة قبل التعليق (نص عادي لتفادي تعارض ترحيل قاعدة البيانات)
  court          String?    // المحكمة المختصة
  opposingParty  String?    // الطرف الآخر
  claimValue     Float?     // قيمة المطالبة
  description    String?
  openedAt       DateTime   @default(now())
  closedAt       DateTime?
  appealDeadline DateTime? // آخر موعد للاستئناف
  appealCategory AppealCategory @default(REGULAR) // تصنيف مدة الاستئناف

  clientId   String
  client     Client @relation(fields: [clientId], references: [id])

  lawyerId   String?
  lawyer     User?   @relation("AssignedLawyer", fields: [lawyerId], references: [id])

  hearings    Hearing[]
  updates     CaseUpdate[]
  documents   CaseDocument[]
  sales       Sale[]
  quotations  Quotation[]
  expenses    Expense[]
  messages    CaseMessage[]
  timeEntries TimeEntry[]
  paymentRequests PaymentRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([lawyerId])
  @@index([status])
  @@index([appealDeadline])
  @@schema("public")
}

model DocumentCategory {
  id        String         @id @default(cuid())
  name      String         @unique
  createdAt DateTime       @default(now())
  serviceRequestDocuments ServiceRequestDocument[]
  documents CaseDocument[]

  @@schema("public")
}

model CaseDocument {
  id           String   @id @default(cuid())
  caseId       String
  case         Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  fileName     String
  fileUrl      String
  fileSize     Int?
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])
  categoryId   String?
  category     DocumentCategory? @relation(fields: [categoryId], references: [id])
  createdAt    DateTime @default(now())

  @@index([caseId])
  @@index([categoryId])
  @@schema("public")
}

model Hearing {
  id           String   @id @default(cuid())
  caseId       String
  case         Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  date         DateTime // موعد الجلسة
  court        String?
  roundNumber  Int?     // رقم الجولة/الجلسة
  notes        String?
  outcome      String?  // نتيجة الجلسة (بعد انعقادها)
  isFinalRuling Boolean @default(false) // هل النتيجة حكم نهائي (يبدأ احتساب الاستئناف)
  reportUrl    String?  // رابط تقرير الجلسة المرفق
  reportName   String?  // اسم ملف تقرير الجلسة
  createdAt    DateTime @default(now())

  @@index([caseId])
  @@index([date])
  @@schema("public")
}

model CaseUpdate {
  id        String   @id @default(cuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  note      String
  createdAt DateTime @default(now())

  @@index([caseId])
  @@schema("public")
}
