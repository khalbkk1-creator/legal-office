// نظام إدارة مكتب المحاماة - قاعدة البيانات
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  // PostgreSQL - مناسب للنشر على Vercel + Supabase
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["public"]
}

enum Role {
  PARTNER   // شريك
  LAWYER    // محامي
  SECRETARY // سكرتير

  @@schema("public")
}

enum CaseStatus {
  UNDER_REVIEW   // تحت الدراسة
  UNDER_APPROVAL // تحت الاعتماد
  ACTIVE         // جارية
  ON_HOLD        // معلقة
  CLOSED         // مغلقة

  @@schema("public")
}

enum ClientType {
  INDIVIDUAL // فرد
  COMPANY    // شركة

  @@schema("public")
}

enum PaymentStatus {
  PAID    // مدفوعة
  UNPAID  // غير مدفوعة
  PARTIAL // مدفوعة جزئياً

  @@schema("public")
}

enum QuotationStatus {
  PENDING  // بانتظار الرد
  ACCEPTED // مقبول
  REJECTED // مرفوض
  EXPIRED  // منتهي الصلاحية

  @@schema("public")
}

model Quotation {
  id              String          @id @default(cuid())
  quoteNumber     String          @unique // رقم عرض السعر
  description     String
  amount          Float
  applyVat        Boolean         @default(true)
  vatAmount       Float           @default(0)
  totalAmount     Float
  status          QuotationStatus @default(PENDING)
  validUntil      DateTime?
  convertedSaleId String? // إذا تحوّل لفاتورة فعلية

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  caseId String?
  case   Case?   @relation(fields: [caseId], references: [id])

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  serviceRequest ServiceRequest?

  @@schema("public")
}

enum ConsultationStatus {
  PENDING   // بانتظار المراجعة
  CONFIRMED // تم التأكيد
  DONE      // تمت الاستشارة
  CANCELLED // ملغاة

  @@schema("public")
}

model ConsultationRequest {
  id             String             @id @default(cuid())
  name           String
  phone          String
  email          String?
  notes          String?
  attachmentUrl  String?
  attachmentName String?
  requestedDate  DateTime // تاريخ ووقت الموعد المطلوب
  status         ConsultationStatus @default(PENDING)
  consultationType String? // PHONE / IN_PERSON / WRITTEN
  serviceRequestId String? // مرجع طلب الخدمة الأصلي إن وجد
  clientId       String?
  client         Client?  @relation(fields: [clientId], references: [id])
  saleId         String?  @unique
  sale           Sale?    @relation(fields: [saleId], references: [id])
  responseFileUrl  String? // ملف الرد للاستشارة الكتابية
  responseFileName String?
  createdAt      DateTime           @default(now())

  noteLog ConsultationNote[]

  @@schema("public")
}

model ConsultationNote {
  id                   String              @id @default(cuid())
  consultationRequestId String
  consultationRequest  ConsultationRequest @relation(fields: [consultationRequestId], references: [id], onDelete: Cascade)
  authorId             String?
  author               User?               @relation(fields: [authorId], references: [id])
  note                 String
  createdAt            DateTime            @default(now())

  @@schema("public")
}

model ExpenseCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  expenses  Expense[]

  @@schema("public")
}

model Expense {
  id          String   @id @default(cuid())
  description String
  amount      Float
  expenseDate DateTime @default(now())

  categoryId String?
  category   ExpenseCategory? @relation(fields: [categoryId], references: [id])

  caseId String?
  case   Case?   @relation(fields: [caseId], references: [id])

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@schema("public")
}

enum ServiceRequestType {
  CASE         // قضية
  CONSULTATION // استشارة

  @@schema("public")
}

enum ServiceRequestStatus {
  NEW             // طلب جديد
  DOCS_REQUESTED  // بانتظار مستندات من العميل
  DOCS_SUBMITTED  // العميل رفع المستندات
  QUOTE_SENT      // تم إرسال عرض سعر
  ACCEPTED        // العميل وافق على العرض
  CONVERTED       // تم التحويل لقضية/استشارة
  REJECTED        // مرفوض

  @@schema("public")
}

model ServiceRequest {
  id                      String               @id @default(cuid())
  clientId                String
  client                  Client               @relation(fields: [clientId], references: [id])
  requestType             ServiceRequestType
  notes                   String?
  status                  ServiceRequestStatus @default(NEW)
  requestedCategoryIds    String[]             @default([])
  clarificationRequest    String? // طلب المحامي من العميل (توضيح إضافي)
  clientReply             String? // رد العميل على طلب التوضيح
  consultationType        String? // PHONE / IN_PERSON / WRITTEN
  requestedDate           DateTime? // تاريخ ووقت الاستشارة المطلوب
  durationMinutes         Int? // مدة الاستشارة بالدقائق
  estimatedCost           Float? // التكلفة المحسوبة تلقائياً
  quotationId             String?              @unique
  quotation               Quotation?           @relation(fields: [quotationId], references: [id])
  convertedCaseId         String?
  convertedConsultationId String?
  createdAt               DateTime             @default(now())

  documents ServiceRequestDocument[]

  @@schema("public")
}

model ServiceRequestDocument {
  id               String         @id @default(cuid())
  serviceRequestId String
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  categoryId       String?
  category         DocumentCategory? @relation(fields: [categoryId], references: [id])
  fileName         String
  fileUrl          String
  fileSize         Int?
  createdAt        DateTime       @default(now())

  @@schema("public")
}

model CaseMessage {
  id         String   @id @default(cuid())
  caseId     String
  case       Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  fromClient Boolean  @default(true) // true = من العميل، false = رد المحامي
  message    String
  createdAt  DateTime @default(now())

  @@schema("public")
}

model TimeEntry {
  id          String   @id @default(cuid())
  caseId      String
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  lawyerId    String
  lawyer      User     @relation(fields: [lawyerId], references: [id])
  description String
  minutes     Int      // مدة العمل بالدقائق
  hourlyRate  Float    // السعر بالساعة وقت التسجيل
  billed      Boolean  @default(false)
  saleId      String?
  sale        Sale?    @relation(fields: [saleId], references: [id])
  entryDate   DateTime @default(now())
  createdAt   DateTime @default(now())

  @@schema("public")
}

model OfficeSettings {
  id            String   @id @default(cuid())
  officeName    String?
  logoUrl       String?
  letterheadUrl String? // صورة ورق الشركة (خلفية كاملة للصفحة)
  taxNumber     String? // الرقم الضريبي
  phone         String?
  address       String?
  defaultHourlyRate Float? // سعر الساعة الافتراضي
  phoneConsultationRate    Float? // سعر ساعة الاستشارة الهاتفية
  inPersonConsultationRate Float? // سعر ساعة الاستشارة الحضورية
  writtenConsultationRate  Float? // سعر ساعة الاستشارة الكتابية
  consultationDays      Int[]    @default([0,1,2,3,4]) // أيام توفر الاستشارات (0=أحد...6=سبت)
  consultationStartTime String? // وقت بداية الحجز، مثال "09:00"
  consultationEndTime   String? // وقت نهاية الحجز، مثال "17:00"
  updatedAt     DateTime @updatedAt

  @@schema("public")
}

model Sale {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique // رقم الفاتورة
  description   String        // وصف الخدمة
  amount        Float         // المبلغ قبل الضريبة
  applyVat      Boolean       @default(true)
  vatAmount     Float         @default(0)
  totalAmount   Float         // المبلغ الإجمالي (شامل الضريبة)
  paidAmount    Float         @default(0)
  paymentStatus PaymentStatus @default(UNPAID)
  saleDate      DateTime      @default(now())

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  caseId String?
  case   Case?   @relation(fields: [caseId], references: [id])

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  timeEntries TimeEntry[]
  consultationRequest ConsultationRequest?

  @@schema("public")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(LAWYER)
  phone        String?
  createdAt    DateTime @default(now())

  assignedCases Case[]        @relation("AssignedLawyer")
  caseUpdates   CaseUpdate[]
  uploadedDocuments CaseDocument[]
  sales         Sale[]
  quotations    Quotation[]
  expenses      Expense[]
  timeEntries   TimeEntry[]
  consultationNotes ConsultationNote[]

  @@schema("public")
}

model Client {
  id        String     @id @default(cuid())
  name      String
  type      ClientType @default(INDIVIDUAL)
  idNumber  String?    // رقم الهوية / السجل التجاري
  phone     String?
  email     String?
  address   String?
  notes     String?
  accessToken String? @unique // رمز رابط بوابة العميل
  createdAt DateTime   @default(now())

  cases Case[]
  sales Sale[]
  quotations Quotation[]
  serviceRequests ServiceRequest[]
  consultationRequests ConsultationRequest[]

  @@schema("public")
}

enum AppealCategory {
  REGULAR   // عادية - 30 يوم
  EXECUTION // تنفيذ - 10 أيام
  URGENT    // مستعجلة - 10 أيام

  @@schema("public")
}

model Case {
  id             String     @id @default(cuid())
  caseNumber     String     @unique // رقم القضية
  title          String     // موضوع القضية
  caseType       String     // نوع القضية (تجارية/عمالية/عقارية...)
  status         CaseStatus @default(UNDER_REVIEW)
  previousStatus String? // الحالة السابقة قبل التعليق (نص عادي لتفادي تعارض ترحيل قاعدة البيانات)
  court          String?    // المحكمة المختصة
  opposingParty  String?    // الطرف الآخر
  claimValue     Float?     // قيمة المطالبة
  description    String?
  openedAt       DateTime   @default(now())
  closedAt       DateTime?
  appealDeadline DateTime? // آخر موعد للاستئناف
  appealCategory AppealCategory @default(REGULAR) // تصنيف مدة الاستئناف

  clientId   String
  client     Client @relation(fields: [clientId], references: [id])

  lawyerId   String?
  lawyer     User?   @relation("AssignedLawyer", fields: [lawyerId], references: [id])

  hearings    Hearing[]
  updates     CaseUpdate[]
  documents   CaseDocument[]
  sales       Sale[]
  quotations  Quotation[]
  expenses    Expense[]
  messages    CaseMessage[]
  timeEntries TimeEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("public")
}

model DocumentCategory {
  id        String         @id @default(cuid())
  name      String         @unique
  createdAt DateTime       @default(now())
  serviceRequestDocuments ServiceRequestDocument[]
  documents CaseDocument[]

  @@schema("public")
}

model CaseDocument {
  id           String   @id @default(cuid())
  caseId       String
  case         Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  fileName     String
  fileUrl      String
  fileSize     Int?
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])
  categoryId   String?
  category     DocumentCategory? @relation(fields: [categoryId], references: [id])
  createdAt    DateTime @default(now())

  @@schema("public")
}

model Hearing {
  id           String   @id @default(cuid())
  caseId       String
  case         Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  date         DateTime // موعد الجلسة
  court        String?
  roundNumber  Int?     // رقم الجولة/الجلسة
  notes        String?
  outcome      String?  // نتيجة الجلسة (بعد انعقادها)
  isFinalRuling Boolean @default(false) // هل النتيجة حكم نهائي (يبدأ احتساب الاستئناف)
  reportUrl    String?  // رابط تقرير الجلسة المرفق
  reportName   String?  // اسم ملف تقرير الجلسة
  createdAt    DateTime @default(now())

  @@schema("public")
}

model CaseUpdate {
  id        String   @id @default(cuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  note      String
  createdAt DateTime @default(now())

  @@schema("public")
}
