// نظام إدارة مكتب المحاماة - قاعدة البيانات
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  // PostgreSQL - مناسب للنشر على Vercel + Supabase
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["public"]
}

enum Role {
  PARTNER   // شريك
  LAWYER    // محامي
  SECRETARY // سكرتير

  @@schema("public")
}

enum CaseStatus {
  UNDER_REVIEW   // تحت الدراسة
  UNDER_APPROVAL // تحت الاعتماد
  ACTIVE         // جارية
  ON_HOLD        // معلقة
  CLOSED         // مغلقة

  @@schema("public")
}

enum ClientType {
  INDIVIDUAL // فرد
  COMPANY    // شركة

  @@schema("public")
}

enum PaymentStatus {
  PAID    // مدفوعة
  UNPAID  // غير مدفوعة
  PARTIAL // مدفوعة جزئياً

  @@schema("public")
}

enum QuotationStatus {
  PENDING  // بانتظار الرد
  ACCEPTED // مقبول
  REJECTED // مرفوض
  EXPIRED  // منتهي الصلاحية

  @@schema("public")
}

model Quotation {
  id              String          @id @default(cuid())
  quoteNumber     String          @unique // رقم عرض السعر
  description     String
  amount          Float
  applyVat        Boolean         @default(true)
  vatAmount       Float           @default(0)
  totalAmount     Float
  status          QuotationStatus @default(PENDING)
  validUntil      DateTime?
  convertedSaleId String? // إذا تحوّل لفاتورة فعلية

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  caseId String?
  case   Case?   @relation(fields: [caseId], references: [id])

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@schema("public")
}

model OfficeSettings {
  id            String   @id @default(cuid())
  officeName    String?
  logoUrl       String?
  letterheadUrl String? // صورة ورق الشركة (خلفية كاملة للصفحة)
  taxNumber     String? // الرقم الضريبي
  phone         String?
  address       String?
  updatedAt     DateTime @updatedAt

  @@schema("public")
}

model Sale {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique // رقم الفاتورة
  description   String        // وصف الخدمة
  amount        Float         // المبلغ قبل الضريبة
  applyVat      Boolean       @default(true)
  vatAmount     Float         @default(0)
  totalAmount   Float         // المبلغ الإجمالي (شامل الضريبة)
  paidAmount    Float         @default(0)
  paymentStatus PaymentStatus @default(UNPAID)
  saleDate      DateTime      @default(now())

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  caseId String?
  case   Case?   @relation(fields: [caseId], references: [id])

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@schema("public")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(LAWYER)
  phone        String?
  createdAt    DateTime @default(now())

  assignedCases Case[]        @relation("AssignedLawyer")
  caseUpdates   CaseUpdate[]
  uploadedDocuments CaseDocument[]
  sales         Sale[]
  quotations    Quotation[]

  @@schema("public")
}

model Client {
  id        String     @id @default(cuid())
  name      String
  type      ClientType @default(INDIVIDUAL)
  idNumber  String?    // رقم الهوية / السجل التجاري
  phone     String?
  email     String?
  address   String?
  notes     String?
  accessToken String? @unique // رمز رابط بوابة العميل
  createdAt DateTime   @default(now())

  cases Case[]
  sales Sale[]
  quotations Quotation[]

  @@schema("public")
}

model Case {
  id             String     @id @default(cuid())
  caseNumber     String     @unique // رقم القضية
  title          String     // موضوع القضية
  caseType       String     // نوع القضية (تجارية/عمالية/عقارية...)
  status         CaseStatus @default(UNDER_REVIEW)
  previousStatus String? // الحالة السابقة قبل التعليق (نص عادي لتفادي تعارض ترحيل قاعدة البيانات)
  court          String?    // المحكمة المختصة
  opposingParty  String?    // الطرف الآخر
  claimValue     Float?     // قيمة المطالبة
  description    String?
  openedAt       DateTime   @default(now())
  closedAt       DateTime?
  appealDeadline DateTime? // آخر موعد للاستئناف

  clientId   String
  client     Client @relation(fields: [clientId], references: [id])

  lawyerId   String?
  lawyer     User?   @relation("AssignedLawyer", fields: [lawyerId], references: [id])

  hearings    Hearing[]
  updates     CaseUpdate[]
  documents   CaseDocument[]
  sales       Sale[]
  quotations  Quotation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("public")
}

model DocumentCategory {
  id        String         @id @default(cuid())
  name      String         @unique
  createdAt DateTime       @default(now())
  documents CaseDocument[]

  @@schema("public")
}

model CaseDocument {
  id           String   @id @default(cuid())
  caseId       String
  case         Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  fileName     String
  fileUrl      String
  fileSize     Int?
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])
  categoryId   String?
  category     DocumentCategory? @relation(fields: [categoryId], references: [id])
  createdAt    DateTime @default(now())

  @@schema("public")
}

model Hearing {
  id           String   @id @default(cuid())
  caseId       String
  case         Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  date         DateTime // موعد الجلسة
  court        String?
  roundNumber  Int?     // رقم الجولة/الجلسة
  notes        String?
  outcome      String?  // نتيجة الجلسة (بعد انعقادها)
  reportUrl    String?  // رابط تقرير الجلسة المرفق
  reportName   String?  // اسم ملف تقرير الجلسة
  createdAt    DateTime @default(now())

  @@schema("public")
}

model CaseUpdate {
  id        String   @id @default(cuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  note      String
  createdAt DateTime @default(now())

  @@schema("public")
}
