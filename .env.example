# قاعدة البيانات - SQLite جاهزة للتشغيل المحلي فوراً
DATABASE_URL="file:./dev.db"

# للانتقال لاحقاً إلى PostgreSQL (مثلاً Supabase):
# DATABASE_URL="postgresql://user:password@host:5432/dbname"

# مفتاح تشفير الجلسات - غيّره لأي نص عشوائي طويل في الإنتاج
NEXTAUTH_SECRET="change-this-to-a-random-secret-in-production"
NEXTAUTH_URL="http://localhost:3000"
